# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nemvol?retryWrites=true&w=majority

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Config
RECIPIENT_EMAIL=nemvolltd@gmail.com
FROM_EMAIL=Nemvol <hello@nemvol.com>

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://nemvol.com

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_RECIPIENT=2348XXXXXXXXX

# Admin
ADMIN_API_KEY=your-secure-admin-api-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
JWT_SECRET=your-jwt-secret-key-change-this
