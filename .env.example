# Frontend: WordPress REST API URL
VITE_WORDPRESS_API_URL=https://nemvol.wordpress.com/wp-json/wp/v2

# Optional frontend API URL (if you run the local backend for email)
VITE_API_URL=http://localhost:5000

# Server: Resend email service (required if running `server`)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=hello@nemvol.com
RECIPIENT_EMAIL=admin@nemvol.com
